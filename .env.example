# חיבור ל-Postgres (מקומי או Supabase). אין כאן סודות אמיתיים — העתיקו ל-.env.local
DATABASE_URL=postgres://postgres@localhost:5433/harel   # מ-./scripts/dev-db.sh start
# PDF (SPEC §8 Playwright): נתיב Chromium אם אינו במיקום ברירת המחדל של Playwright
# CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
# הגנה על /api/jobs/* (חלק ג׳): חובה ב-production. ה-cron שולח x-jobs-secret.
JOBS_SECRET=
# וואטסאפ דרך Green-API (SPEC §9 שלב 5). בלי זה ההודעות נשארות pending ב-outbox.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# כתובת המערכת בקישורים שבהודעות
APP_BASE_URL=http://localhost:3000
# ADDENDUM ב.1 — OAuth של המשתמש מול Google (Google Cloud Console → OAuth client, redirect: <APP_BASE_URL>/api/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# הנחיה 15 — מפתח הצפנה ל-refresh token (מחוץ ל-DB). ב-Supabase: Vault.
SECRETS_KEY=
# ב.3 — LLM כהצעה בלבד לחשבונית של ספק לא מוכר (הנחיה 17). בלי מפתח: כללים + הזנה ידנית.
ANTHROPIC_API_KEY=
